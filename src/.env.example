# ============================================================
# Container Congestion Predictor — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.

# ── Google Gemini API ─────────────────────────────────────────
# Required for AI-generated 72-hour operations brief.
# Get a FREE key in 2 minutes: https://aistudio.google.com → Get API key
# Without this key the app uses a rule-based brief fallback (still fully functional).
GEMINI_API_KEY=your_gemini_api_key_here

# ── Backend server ────────────────────────────────────────────
APP_PORT=8000
APP_ENV=development         # or: production

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev: leave as-is.
# Render deployment: add your Vercel URL here, e.g.:
#   CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Frontend (Vite) ──────────────────────────────────────────
# Points the React app at the backend.
# Local dev: leave blank (Vite proxy handles /api → localhost:8000).
# Vercel deployment: set to your Render backend URL, e.g.:
#   VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=

# ============================================================
# RENDER DEPLOYMENT (backend)
# ============================================================
# In Render Dashboard → Environment:
#   GEMINI_API_KEY   = <your key>
#   CORS_ORIGINS     = https://your-app.vercel.app
#   APP_ENV          = production
#
# Render Build Command:
#   pip install -r src/backend/requirements.txt
#
# Render Start Command:
#   uvicorn backend.main:app --app-dir src --host 0.0.0.0 --port $PORT
#
# Root Directory: (leave blank — repo root)

# ============================================================
# VERCEL DEPLOYMENT (frontend)
# ============================================================
# In Vercel Dashboard → Settings → Environment Variables:
#   VITE_API_URL = https://your-backend.onrender.com
#
# Vercel Framework Preset: Vite
# Root Directory: src/frontend
# Build Command: npm run build
# Output Directory: dist
